PORT=3000
# Local sin Docker: localhost. Con docker compose se sobrescribe a mongodb://mongo:27017/acceso_reventa
MONGODB_URI=mongodb://localhost:27017/acceso_reventa
# Opcional para pruebas de integración: mongodb://localhost:27017/pase-seguro-test
MONGO_TEST_URI=
# Secreto compartido con Eventos y boletas para la firma HMAC del QR (mínimo 16 caracteres)
QR_SECRET=
# URL base del gateway del clúster (sin / al final)
GATEWAY_URL=
# Valor de la cabecera X-Gateway-Secret que agrega el gateway; sin ella el servicio responde 403
GATEWAY_SECRET=
GATEWAY_TOKEN_PATH=/token
GATEWAY_TIMEOUT_MS=3000
GATEWAY_MAX_RETRIES=2
# Credenciales Client Credentials que entrega el líder del gateway
CLIENT_ID=
CLIENT_SECRET=
TOPE_REVENTA_PCT=110
